// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ORGANIZER
  CONTROLLER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CampaignType {
  INVITATION
  CONFIRMATION
  REMINDER_7D
  REMINDER_1D
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PARTIALLY_SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}

enum TicketStatus {
  PENDING
  VALID
  USED
  CANCELLED
  FRAUDULENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  CONCERT
  CONFERENCE
  FESTIVAL
  SPORT
  PARTY
  EXHIBITION
  THEATER
  WORKSHOP
  GALA
  COMEDY
  WORSHIP
  FAIR
  OTHER
}

enum ScanResult {
  VALID
  ALREADY_USED
  INVALID
  FRAUDULENT
  EXPIRED
}

enum TeamMemberRole {
  MANAGER
  STAFF
  VOLUNTEER
  SECURITY
  PRESS
  VIP
  ARTIST
  SPONSOR
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  firstName             String
  lastName              String
  role                  Role      @default(ORGANIZER)
  isEmailVerified       Boolean   @default(false)
  emailVerificationToken String?
  emailVerificationExpiry DateTime?
  twoFactorSecret       String?
  twoFactorEnabled      Boolean   @default(false)
  passwordResetToken    String?
  passwordResetExpiry   DateTime?
  refreshToken          String?
  isActive              Boolean   @default(true)
  avatar                String?
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  events       Event[]
  controllers  Controller[]
  keyPairs     KeyPair[]
  auditLogs    AuditLog[]
  subscription OrganizerSubscription?
  sentInvitations    ProjectInvitation[] @relation("SentInvitations")
  projectMemberships ProjectMember[]
  taskAssignments    TaskAssignee[]
  notificationTemplates NotificationTemplate[] @relation("UserTemplates")
  notificationCampaigns NotificationCampaign[] @relation("UserCampaigns")
  notifications         Notification[]
  accountCollaborators  AccountMember[] @relation("AccountOwner")
  accountMemberships    AccountMember[] @relation("AccountMemberships")
  accessZones           AccessZone[]
  eventDrafts           EventDraft[]
  billingAccount        BillingAccount?
  billingPayments       BillingPayment[]
  payouts               Payout[]
  /// Where sales are paid out: { method: 'mobile_money'|'bank', phone?, network?, bankName?, accountNumber?, accountName? }
  payoutInfo            Json?
}

model Event {
  id               String      @id @default(uuid())
  name             String
  description      String?
  /// Artists, bands or speakers, as shown on the event page (and to search engines)
  performers       String[]    @default([])
  venue            String
  address          String?
  city             String
  country          String
  startDate        DateTime
  endDate          DateTime
  totalCapacity    Int
  status           EventStatus @default(DRAFT)
  type             EventType   @default(OTHER)
  currency         String      @default("USD")
  bannerUrl        String?
  organizerId      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organizer         User               @relation(fields: [organizerId], references: [id])
  ticketTemplates   TicketTemplate[]
  tickets           Ticket[]
  controllerEvents  ControllerEvent[]
  teamMembers       TeamMember[]
  accreditations    Accreditation[]
  tasks             EventTask[]
  budgetLines       BudgetLine[]
  projectInvitations ProjectInvitation[]
  projectMembers     ProjectMember[]
  campaigns          NotificationCampaign[]
  payments           Payment[]
  views           EventView[]
  products         Product[]
  merchOrders      MerchOrder[]
  // Shop settings: delivery is offered when merchDeliveryFee is set (0 = free delivery)
  merchDeliveryFee Decimal? @db.Decimal(10, 2)
  merchPickupInfo  String?
  /// Who pays ZAYA's 9 % on paid tickets: 'ORGANIZER' (taken from the price) or 'BUYER' (added to it)
  feePayer         String   @default("ORGANIZER")
  payouts          Payout[]
}

model TeamMember {
  id           String         @id @default(uuid())
  eventId      String
  name         String
  email        String?
  phone        String?
  role         TeamMemberRole @default(STAFF)
  department   String?
  notes        String?
  photoUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accreditation Accreditation?
}

model Accreditation {
  id           String    @id @default(uuid())
  teamMemberId String    @unique
  eventId      String
  code         String    @unique
  zones        Json      @default("[]")
  validFrom    DateTime?
  validUntil   DateTime?
  isActive     Boolean   @default(true)
  printedAt    DateTime?
  badgeConfig  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model TicketTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  quantity        Int
  availableCount  Int
  color           String   @default("#1a1a2e")
  logoUrl         String?
  backgroundUrl   String?
  customFields    Json?
  // Days the tariff is valid ('YYYY-MM-DD', Kinshasa time); empty = every day of the event.
  // Several days = a pass: one entry per day
  validDays       String[] @default([])
  eventId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]
}

model Ticket {
  id               String       @id @default(uuid())
  serialNumber     String       @unique
  qrCode           String?      @db.Text
  qrCodeSignature  String?      @db.Text
  holderName       String?
  holderEmail      String?
  holderPhone      String?
  status           TicketStatus @default(PENDING)
  price            Decimal      @db.Decimal(10, 2)
  currency         String       @default("USD")
  purchasedAt      DateTime?
  checkedInAt      DateTime?
  cancelledAt      DateTime?
  metadata         Json?
  /// GENERATION / INVITATION (count against the print quota) or ONLINE (sale or registration: never counted)
  source           String       @default("GENERATION")
  eventId          String
  templateId       String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  event           Event          @relation(fields: [eventId], references: [id])
  template        TicketTemplate @relation(fields: [templateId], references: [id])
  scanValidations ScanValidation[]
}

model Controller {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String?
  isActive        Boolean   @default(false)
  organizerId     String
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invitationToken String?   @unique
  invitedAt       DateTime?
  refreshToken    String?

  organizer        User              @relation(fields: [organizerId], references: [id])
  controllerEvents ControllerEvent[]
  scanValidations  ScanValidation[]
}

model ControllerEvent {
  id           String   @id @default(uuid())
  controllerId String
  eventId      String
  assignedAt   DateTime @default(now())

  controller Controller @relation(fields: [controllerId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([controllerId, eventId])
}

model ScanValidation {
  id             String     @id @default(uuid())
  ticketId       String?    // nullable — null when QR code is invalid/unrecognized
  controllerId   String
  result         ScanResult
  scannedAt      DateTime   @default(now())
  deviceId       String?
  location       String?
  ipAddress      String?
  notes          String?
  isSynced       Boolean    @default(true)
  offlineScannedAt DateTime?

  ticket     Ticket?    @relation(fields: [ticketId], references: [id])
  controller Controller @relation(fields: [controllerId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model KeyPair {
  id          String   @id @default(uuid())
  publicKey   String   @db.Text
  privateKey  String   @db.Text
  algorithm   String   @default("RSA-4096")
  isActive    Boolean  @default(true)
  organizerId String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  organizer User @relation(fields: [organizerId], references: [id])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  price           Float    @default(0)
  maxTickets      Int      @default(200)
  maxBadges       Int      @default(50)
  maxEvents       Int      @default(-1)
  showPoweredBy        Boolean  @default(true)
  allowBulkExport      Boolean  @default(true)
  allowCommunication   Boolean  @default(false)
  /// FREE / STARTER / PRO: the plans of the pricing page
  code            String?  @unique
  /// Quota period: 'EVENT' (per event, free plan) or 'MONTH' (paid plans)
  period          String   @default("MONTH")
  /// Controllers the organizer can have (-1 = unlimited)
  maxControllers  Int      @default(-1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions OrganizerSubscription[]
}

model OrganizerSubscription {
  id          String             @id @default(uuid())
  organizerId String             @unique
  planId      String
  status      SubscriptionStatus @default(ACTIVE)
  ticketsUsed Int                @default(0)
  badgesUsed  Int                @default(0)
  startsAt    DateTime           @default(now())
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  organizer User             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
}

model EventTask {
  id           String    @id @default(uuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       String    @default("TODO")
  priority     String    @default("MEDIUM")
  category     String?
  assigneeName String?
  assigneeId   String?
  dueDate      DateTime?
  position     Int       @default(0)
  startDate    DateTime?
  assignees    TaskAssignee[]
  pendingAssignees TaskPendingAssignee[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A task assigned to someone who has no account yet (pending project invitation or
// pending account collaborator). Turned into a TaskAssignee when they sign in.
model TaskPendingAssignee {
  id        String    @id @default(uuid())
  taskId    String
  task      EventTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  createdAt DateTime  @default(now())

  @@unique([taskId, email])
  @@index([email])
}

model BudgetLine {
  id            String          @id @default(uuid())
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category      String
  label         String
  plannedAmount Float           @default(0)
  expenses      BudgetExpense[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model BudgetExpense {
  id           String     @id @default(uuid())
  budgetLineId String
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  label        String
  amount       Float
  date         DateTime   @default(now())
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model TaskAssignee {
  id        String    @id @default(uuid())
  taskId    String
  task      EventTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([taskId, userId])
}

model ProjectInvitation {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email       String
  firstName   String
  lastName    String
  projectRole String    @default("CONTRIBUTOR")
  token       String    @unique
  status      String    @default("PENDING")
  invitedById String
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectMember {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole String   @default("CONTRIBUTOR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, userId])
}

model NotificationTemplate {
  id          String              @id @default(uuid())
  name        String
  channel     NotificationChannel
  subject     String?
  body        String              @db.Text
  isDefault   Boolean             @default(false)
  organizerId String
  organizer   User                @relation("UserTemplates", fields: [organizerId], references: [id], onDelete: Cascade)
  campaigns   NotificationCampaign[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model NotificationCampaign {
  id          String              @id @default(uuid())
  name        String
  eventId     String
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel     NotificationChannel
  type        CampaignType        @default(CUSTOM)
  subject     String?
  body        String              @db.Text
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id])
  scheduledAt DateTime?
  sentAt      DateTime?
  status      CampaignStatus      @default(DRAFT)
  totalSent   Int                 @default(0)
  totalFailed Int                 @default(0)
  createdById String
  createdBy   User                @relation("UserCampaigns", fields: [createdById], references: [id])
  recipients  CampaignRecipient[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CampaignRecipient {
  id          String          @id @default(uuid())
  campaignId  String
  campaign    NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email       String?
  phone       String?
  firstName   String
  lastName    String
  ticketId    String?
  status      RecipientStatus @default(PENDING)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime        @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  PROCESSING // verified with FlexPay, tickets being generated (claimed by one worker only)
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED // paid, then given back to the buyer (Refund)
}

model Payment {
  id            String        @id @default(cuid())
  reference     String        @unique
  orderNumber   String?
  eventId       String
  holderName    String
  holderEmail   String
  holderPhone   String?
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  paymentMethod String
  /// Tickets subtotal at the listed prices, ZAYA's fee on it, and who paid that fee
  ticketAmount  Decimal?      @db.Decimal(10, 2)
  feeAmount     Decimal       @default(0) @db.Decimal(10, 2)
  feePayer      String?
  /// What the organizer is owed for this order (tickets net of the fee, plus shop items)
  netAmount     Decimal?      @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  items         Json
  providerRef   String?
  ticketsData   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id])
  refund Refund?

  @@index([reference])
  @@index([orderNumber])
  @@index([status])
  merchOrder    MerchOrder?
}

// Collaborators of an organizer account: a person (with their own ZAYA login) who works
// in the owner's workspace with a permission level: ADMIN | MANAGER | TICKETING | VIEWER.
// userId stays null until someone signs up / logs in with the invited email.
model AccountMember {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  email       String
  userId      String?
  user        User?    @relation("AccountMemberships", fields: [userId], references: [id], onDelete: Cascade)
  permission  String   @default("VIEWER")
  invitedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, email])
  @@index([userId])
  @@index([email])
}

// Access zones printed on accreditation badges, managed per organizer account
model AccessZone {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#64748b")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
}

// A visit to an event's public sales page (audience statistics). Privacy: no IP or cookie
// is stored — visitorHash is a salted daily hash (ip + user agent + day), the location is
// city-level from an offline GeoIP database with coordinates rounded to ~10 km.
model EventView {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitorHash String
  country     String?
  region      String?
  city        String?
  lat         Float?
  lng         Float?
  referrer    String?
  source      String?
  device      String?
  createdAt   DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([eventId, visitorHash])
}

// ─── Shop (event merchandise) ─────────────────────────────────────────────────

model Product {
  id          String           @id @default(uuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?          @db.Text
  price       Decimal          @db.Decimal(10, 2)
  currency    String
  isActive    Boolean          @default(true)
  position    Int              @default(0)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([eventId])
}

// One sellable combination (size / color), with its own stock. A product without
// options has a single variant with size and color null.
model ProductVariant {
  id         String           @id @default(uuid())
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String?
  color      String?
  stock      Int              @default(0)
  position   Int              @default(0)
  orderItems MerchOrderItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// PENDING_PAYMENT → PAID → READY → PICKED_UP (pickup) | SHIPPED → DELIVERED (delivery); CANCELLED
model MerchOrder {
  id              String           @id @default(uuid())
  code            String           @unique // short code shown to the buyer / stand, e.g. B-7K3P9Q
  eventId         String
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentId       String?          @unique
  payment         Payment?         @relation(fields: [paymentId], references: [id])
  buyerName       String
  buyerEmail      String
  buyerPhone      String?
  fulfillment     String           // PICKUP | DELIVERY
  deliveryAddress String?
  deliveryCity    String?
  deliveryNotes   String?
  subtotal        Decimal          @db.Decimal(10, 2)
  deliveryFee     Decimal          @default(0) @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  currency        String
  status          String           @default("PENDING_PAYMENT")
  paidAt          DateTime?
  fulfilledAt     DateTime?
  items           MerchOrderItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([eventId, status])
}

model MerchOrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       MerchOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  size        String?
  color       String?
  unitPrice   Decimal        @db.Decimal(10, 2)
  quantity    Int
}

/// Event form saved before the event is created, to finish it later
model EventDraft {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Form values and tariffs, as typed
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// Paid print credits of an organizer, used once the plan quota is reached
model BillingAccount {
  organizerId   String   @id
  organizer     User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  ticketCredits Int      @default(0)
  badgeCredits  Int      @default(0)
  updatedAt     DateTime @updatedAt
}

/// What an organizer pays ZAYA: a plan month or print credits (FlexPay)
model BillingPayment {
  id            String        @id @default(uuid())
  reference     String        @unique
  orderNumber   String?
  organizerId   String
  organizer     User          @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  /// PLAN, TICKETS or BADGES
  kind          String
  planId        String?
  quantity      Int?
  unitPrice     Decimal?      @db.Decimal(10, 4)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  paymentMethod String
  phone         String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  /// Receipt number, given when the payment is confirmed (R-<number>)
  receiptNumber Int?          @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([organizerId])
}

/// Sales paid out to an organizer for an event: MAIN (90 %, 3 days after the end), RESERVE (10 %, 7 days later)
model Payout {
  id          String   @id @default(uuid())
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  part        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  /// Transfer reference (mobile money transaction, bank wire)
  reference   String?
  note        String?
  paidById    String?
  paidAt      DateTime @default(now())

  @@unique([eventId, part])
  @@index([organizerId])
}

/// An online order given back to its buyer: asked by the organizer, transferred by the ZAYA team
model Refund {
  id            String    @id @default(uuid())
  paymentId     String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id])
  eventId       String
  organizerId   String
  /// What the buyer paid, given back in full
  amount        Decimal   @db.Decimal(12, 2)
  currency      String
  reason        String?
  /// REQUESTED, then PAID once the transfer is made
  status        String    @default("REQUESTED")
  requestedById String?
  requestedAt   DateTime  @default(now())
  paidAt        DateTime?
  paidById      String?
  /// Transfer reference (mobile money transaction, card refund)
  reference     String?
  note          String?

  @@index([status])
  @@index([eventId])
}
